msgid "Апаратний криптографічний прискорювач (AES, RSA, RNG, HMAC)"
msgstr ""

#: ../../hardware/mcu.rst:37
msgid ""
"USB-контролер (з підтримкою USB-OTG та CDC, що дозволяє програмувати "
